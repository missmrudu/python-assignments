   "source": [
    "#Define a function that uses loop to print all the even number between 1 to 100 and call it\n",
    "\n",
    "def even_no():\n",
    "    for i in range(1, 101):\n",
    "        if i % 2 == 0:\n",
    "            print(i)\n",
    "even_no()"
